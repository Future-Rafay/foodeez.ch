# ==========================================
# Database
# ==========================================
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=your_database_user
DATABASE_PASSWORD=your_database_password
DATABASE_NAME=your_database_name
DATABASE_URL=mysql://your_database_user:your_database_password@localhost:3306/your_database_name

# Production Database (Optional)
# DATABASE_HOST=your-production-host
# DATABASE_PORT=3306
# DATABASE_USER=your-production-user
# DATABASE_PASSWORD=your-production-password
# DATABASE_NAME=your-production-database
# DATABASE_URL=mysql://your-production-user:your-production-password@your-production-host:3306/your-production-database

# ==========================================
# Stripe
# ==========================================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# ==========================================
# Google Maps
# ==========================================
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
NEXT_PUBLIC_GOOGLE_CACHE_TTL_MS=777600000

# ==========================================
# NextAuth
# ==========================================
NEXTAUTH_SECRET=your_nextauth_secret
NEXTAUTH_URL=http://localhost:3000

# ==========================================
# Google OAuth
# ==========================================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ==========================================
# Email (Resend)
# ==========================================
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=Foodeez <notifications@foodeez.ch>
ADMIN_EMAIL=admin@example.com

# ==========================================
# Application
# ==========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==========================================
# Storage (AWS S3)
# ==========================================
STORAGE_DRIVER=s3

S3_BUCKET=your_bucket_name
S3_REGION=us-east-1
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_FORCE_PATH_STYLE=false
S3_UPLOAD_MAX_MB=50

# ==========================================
# WordPress
# ==========================================
WP_API_BASE=https://example.com/wp-json/wp/v2
WP_MAIN_CATEGORY_SLUG=your-category-slug
